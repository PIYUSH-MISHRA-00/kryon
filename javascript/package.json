{
  "name": "kryon",
  "version": "1.0.0",
  "description": "Powerful terminal execution, everywhere â€” command execution, process control and streaming, with one conceptual API across languages.",
  "keywords": [
    "terminal",
    "subprocess",
    "process",
    "child-process",
    "command-execution",
    "shell",
    "spawn",
    "streaming",
    "pty",
    "cross-platform"
  ],
  "homepage": "https://piyush-mishra-00.github.io/kryon/",
  "bugs": "https://github.com/PIYUSH-MISHRA-00/kryon/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PIYUSH-MISHRA-00/kryon.git",
    "directory": "javascript"
  },
  "license": "Apache-2.0",
  "author": "PIYUSH-MISHRA-00 <piyushmishra.professional@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test test/api.test.mjs test/conformance.test.mjs",
    "prepublishOnly": "npm run clean && npm run build && node --test test/api.test.mjs test/conformance.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
